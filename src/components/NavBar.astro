---
import navItems from "../nav.json";
---

<header class="cont flex items-center justify-between gap-4 py-6 sm:py-8">
  <a
    href="/"
    class="font-space text-base leading-tight font-bold tracking-tight text-ink sm:text-xl"
  >
    Maxemilian Grönblom
  </a>
  <nav aria-label="Main">
    <ul class="flex gap-1 font-space text-sm sm:gap-2 sm:text-base">
      {navItems.map((item) => (
        <li>
          <a
            href={item.target}
            data-nav-link
            class="block rounded-lg px-2 py-1.5 text-ink-muted transition-colors hover:bg-surface hover:text-ink sm:px-3"
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  function markActive() {
    for (const link of links) {
      const active = location.href === link.href;
      link.classList.toggle("active", active);
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
  }

  markActive();
  window.addEventListener("hashchange", markActive);
</script>

<style>
  @reference "../styles/global.css";

  a.active {
    @apply bg-surface text-ink shadow-sm ring-1 ring-line;
  }
</style>
