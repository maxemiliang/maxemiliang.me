---
import type { ImageMetadata } from "astro";
import type { SvgComponent } from "astro/types";
import { Picture } from "astro:assets";
import Button from "./Button.astro";

interface Props {
  title: string;
  tone: "sky" | "moss";
  tech: { name: string; icon: SvgComponent }[];
  image: ImageMetadata;
  imageAlt: string;
  imageHeight: number;
  imageFramed?: boolean;
  repository: string;
}

const {
  title,
  tone,
  tech,
  image,
  imageAlt,
  imageHeight,
  imageFramed = false,
  repository,
} = Astro.props;

const tones = {
  sky: "bg-sky",
  moss: "bg-moss",
};
---

<article
  data-reveal="card"
  class:list={[
    "group grid gap-10 overflow-clip rounded-[2rem] p-7 text-white sm:p-10 md:grid-cols-5 md:items-center md:gap-12 lg:p-14",
    tones[tone],
  ]}
>
  <div class="md:col-span-3">
    <h3 class="text-3xl sm:text-4xl">{title}</h3>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
      {tech.map(({ name, icon: Icon }, i) => (
        <li
          data-pop
          style={`--i: ${i}`}
          class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-sm font-medium ring-1 ring-white/20 ring-inset"
        >
          <Icon class="tech-icon size-4" aria-hidden="true" />
          {name}
        </li>
      ))}
    </ul>
    <div class="project-body mt-6 max-w-[60ch] text-white/90">
      <slot />
    </div>
    <div class="mt-8">
      <Button
        href={repository}
        variant="light"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 4v12l-4-2-4 2V4M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Repositories
      </Button>
    </div>
  </div>
  <div data-parallax class="flex justify-center md:col-span-2">
    <Picture
      data-slide
      src={image}
      height={imageHeight}
      formats={["avif", "webp"]}
      alt={imageAlt}
      class:list={[
        "h-auto max-w-full transition-[rotate,scale] duration-500 ease-out motion-safe:group-hover:scale-[1.03] motion-safe:group-hover:-rotate-1",
        imageFramed &&
          "rounded-xl shadow-2xl ring-1 shadow-black/30 ring-black/10",
      ]}
    />
  </div>
</article>

<style>
  :global(.tech-icon *) {
    fill: currentColor;
  }

  .project-body :global(p + p),
  .project-body :global(p + ul),
  .project-body :global(ul + p) {
    margin-top: 1rem;
  }

  .project-body :global(ul) {
    display: grid;
    gap: 0.375rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .project-body :global(li::marker) {
    color: rgb(255 255 255 / 0.6);
  }

  .project-body :global(strong) {
    color: white;
    font-weight: 600;
  }
</style>
