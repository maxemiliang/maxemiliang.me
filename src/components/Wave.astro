  class:list={["h-auto text-signal", className]}
  viewBox={wave.viewBox}
  aria-hidden="true"
  data-draw={draw ? "" : undefined}
>
  <path
    d={wave.d}
    pathLength="1"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
  ></path>
</svg>
