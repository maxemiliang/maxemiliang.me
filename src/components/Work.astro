---
import Project from "./Project.astro";
import Wave from "./Wave.astro";
import weatherdash from "../assets/weatherdash.webp";
import storedash from "../assets/storedash.webp";
import NodejsIcon from "devicon/icons/nodejs/nodejs-plain.svg";
import ExpressIcon from "devicon/icons/express/express-original.svg";
import JavaIcon from "devicon/icons/java/java-plain.svg";
import KubernetesIcon from "devicon/icons/kubernetes/kubernetes-plain.svg";
import PostgresqlIcon from "devicon/icons/postgresql/postgresql-plain.svg";
import ElixirIcon from "devicon/icons/elixir/elixir-plain.svg";
import QtIcon from "devicon/icons/qt/qt-original.svg";
import FlutterIcon from "devicon/icons/flutter/flutter-plain.svg";
---

<section id="projects" class="cont py-16 sm:py-24">
  <h2 class="text-3xl sm:text-4xl">My projects</h2>
  <Wave variant="projects" class="mt-1 w-48" />

  <div class="mt-10 grid gap-8">
    <Project
      title="Weatherdash"
      tone="sky"
      tech={[
        { name: "Node.js", icon: NodejsIcon },
        { name: "Express", icon: ExpressIcon },
        { name: "Java", icon: JavaIcon },
      ]}
      image={weatherdash}
      imageAlt="The Weatherdash GUI application"
      imageHeight={360}
      imageFramed
      repository="https://git.maxemiliang.cloud/groups/prog3"
    >
      <p>
        Weatherdash collects, stores and visualizes weather data from
        custom-built sensors running on the NodeMCU platform. It consists of
        three main components and one minor one:
      </p>
      <ul>
        <li>API server (Node.js/Express)</li>
        <li>Sensor software (NodeMCU/PlatformIO/C++)</li>
        <li>GUI (Java/JavaFX)</li>
        <li>Collector worker (Node.js)</li>
      </ul>
    </Project>

    <Project
      title="StoreDash"
      tone="moss"
      tech={[
        { name: "Kubernetes", icon: KubernetesIcon },
        { name: "PostgreSQL", icon: PostgresqlIcon },
        { name: "Elixir", icon: ElixirIcon },
        { name: "Qt", icon: QtIcon },
        { name: "Flutter", icon: FlutterIcon },
      ]}
      image={storedash}
      imageAlt="The StoreDash mobile app showing an indoor store map"
      imageHeight={340}
      repository="https://github.com/storedash-project"
    >
      <p>
        StoreDash is a group project from a project course. It lets stores
        create indoor maps, which a client app then uses to guide customers
        around. <strong>Think Google Maps, but for stores.</strong>
      </p>
      <p>
        Most of the source code isn't public, but here are some of the
        technologies we used:
      </p>
      <ul>
        <li>Kubernetes, Postgres, Pulumi</li>
        <li>Elixir, Plug, Ecto</li>
        <li>C++, Qt</li>
        <li>Flutter</li>
      </ul>
    </Project>
  </div>
</section>
