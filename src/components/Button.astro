---
// A "keycap" button: the thick bottom edge compresses when pressed.
// Renders a link when `href` is given, otherwise a <button>.

import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: keyof typeof variants;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "class">;

const variants = {
  primary: "bg-sky text-white border-sky-deep",
  secondary: "bg-surface text-ink border-line",
  light: "bg-white text-slate-900 border-black/25",
};

const { variant = "secondary", href, class: className, ...attrs } = Astro.props;

const classes = [
  "inline-flex items-center gap-x-2 rounded-xl border-b-4 px-4 py-2.5 font-space text-base font-bold whitespace-nowrap shadow-sm transition-[translate,border-width,box-shadow] duration-150 ease-out hover:-translate-y-0.5 hover:shadow-md active:translate-y-0.5 active:border-b-2 active:shadow-none [&_svg]:size-5 [&_svg]:shrink-0",
  variants[variant],
  className,
];
---

{href ? (
  <a href={href} class:list={classes} {...attrs}>
    <slot />
  </a>
) : (
  <button type="button" class:list={classes} {...attrs}>
    <slot />
  </button>
)}
