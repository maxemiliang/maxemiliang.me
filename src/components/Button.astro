---
// A button

interface Props {
  variant?: "default" | "primary";
  classes?: string;
}

const { variant = "default", classes } = Astro.props;

const variants = {
  default: "bg-white text-slate-700",
  primary: "bg-blue-600 text-white border-blue-700",
};
---

<button
  type="button"
  class:list={[
    "flex flex-1 items-center gap-x-2 rounded-md border-b-4 px-3 py-2 font-space shadow-md transition-colors duration-200 hover:-translate-y-0.5! hover:border-slate-500 hover:bg-slate-700 hover:text-white hover:transition-transform!",
    variants[variant],
    classes,
  ]}
>
  <slot />
</button>
