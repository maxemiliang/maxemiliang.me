---
import Head from "./Head.astro";
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";

const title = "Maxemilian Grönblom";
const description =
  "Hello there! I'm Maxemilian Grönblom, an enthusiastic web developer from Finland.";
---

<html lang="en">
  <head>
    <Head {title} {description} />
  </head>
  <body>
    <NavBar />
    <main>
      <slot />
    </main>
    <footer class="cont border-t py-8 text-sm text-ink-muted">
      © {new Date().getFullYear()} Maxemilian Grönblom
    </footer>
  </body>
</html>
