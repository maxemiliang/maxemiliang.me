---
import { Picture } from "astro:assets";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Work from "../components/Work.astro";
import Contact from "../components/Contact.astro";
import Button from "../components/Button.astro";
import Wave from "../components/Wave.astro";
import profile from "../assets/profile.webp";
---

<DefaultLayout>
  <section
    id="intro"
    class="cont grid items-center gap-10 pt-8 pb-8 sm:pt-16 sm:pb-12 md:grid-cols-[auto_1fr] md:gap-16"
  >
    <div data-intro-avatar class="relative w-fit">
      <div
        class="absolute inset-0 translate-x-3 translate-y-3 rounded-full bg-signal/25"
        aria-hidden="true"
      ></div>
      <Picture
        src={profile}
        height={320}
        formats={["avif", "webp"]}
        alt="Maxemilian smiling in front of a waterfall"
        loading="eager"
        fetchpriority="high"
        class="relative size-44 rounded-full object-cover ring-4 ring-surface sm:size-56 lg:size-64"
      />
    </div>

    <div>
      <h1 data-intro style="--i: 0" class="text-5xl sm:text-6xl lg:text-7xl">
        Hello there!
      </h1>
      <Wave variant="short" draw class="mt-2 w-32 sm:w-40" />

      <!-- prettier-ignore -->
      <p data-intro style="--i: 1" class="mt-6 max-w-[52ch] text-xl leading-relaxed text-ink-muted sm:text-2xl sm:leading-relaxed">
        You appear to have stumbled upon my portfolio. My name is
        <strong class="font-semibold text-ink">Maxemilian</strong>. I study
        <strong class="font-semibold text-ink">Computer Science</strong> at
        <a href="https://abo.fi" target="_blank" rel="noreferrer nofollow" class="text-link">Åbo Akademi University</a>
        and work as a developer at
        <a href="https://jco.fi" target="_blank" rel="noreferrer nofollow" class="text-link">JCO Digital</a>.
      </p>

      <div data-intro style="--i: 2" class="mt-8 flex flex-wrap gap-3">
        <Button href="#contact" variant="primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
          </svg>
          Let's talk!
        </Button>
        <Button href="#projects">See my projects</Button>
      </div>
    </div>
  </section>
  <Work />
  <Contact />
</DefaultLayout>
